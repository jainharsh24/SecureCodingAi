DATABASE_URL=jdbc:postgresql://localhost:5432/securecode
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=your-postgresql-password
AUTH_TOKEN_SECRET=replace-with-a-long-random-development-secret

# Judge0 API
JUDGE0_BASE_URL=http://localhost:2358
JUDGE0_AUTH_TOKEN=
JUDGE0_POLL_INTERVAL_MS=500
JUDGE0_MAX_WAIT_MS=30000

# Semgrep runs through the configured WSL distribution.
SEMGREP_ENABLED=true
SEMGREP_WSL_DISTRIBUTION=Ubuntu
SEMGREP_EXECUTABLE=semgrep
SEMGREP_RULES_PATH=tools/semgrep/rules/java-security.yml
SEMGREP_TIMEOUT_MS=30000

# SpotBugs and FindSecBugs run in the same Windows environment as Spring Boot.
SPOTBUGS_ENABLED=true
SPOTBUGS_EXECUTABLE=C:/path/to/spotbugs/bin/spotbugs.bat
FINDSECBUGS_PLUGIN_PATH=C:/path/to/spotbugs/plugin/findsecbugs-plugin.jar
SPOTBUGS_JAVAC_EXECUTABLE=C:/path/to/jdk/bin/javac.exe
SPOTBUGS_TIMEOUT_MS=30000
